#!name=G1 ACQ
#!desc=v7.9.0 SKU管理兼容入口：运行版本g1-acq-v7.9-mappings；本机报告页支持添加、编辑、启停、保存、删除映射与恢复默认，最多30条，保存后下一次 /ai? 响应生效；默认discount75保留20TB 12个月试用目标g1.play.20tb.12months_eft、30TB三个月75p与2TB目标g1.2tb.ai.12months_ip_90p（无 .acq），自定义为custom，fallback=false；保留被动采集、最近10次响应与JSON导出；与G1 ACQ SKU 管理仅开启一个改写入口，重新连接再打开方案页
#!system=ios

[Rule]
# 拦截 UDP 443，促使支持回退的 HTTP/3 请求改走 TCP。
AND,((PROTOCOL,UDP),(DEST-PORT,443)),REJECT-NO-DROP

[Script]
g1-acq = type=http-response,pattern=^https:\/\/one\.google\.com\/,requires-body=1,max-size=0,script-path=https://cdn.jsdelivr.net/gh/chengyixu/g1-acq@main/g1-acq.js
g1-sku-report = type=http-request,pattern=^https:\/\/one\.google\.com\/g1-sku-report\/?(?:\?.*)?$,requires-body=1,max-size=0,script-path=https://cdn.jsdelivr.net/gh/chengyixu/g1-acq@main/g1-sku-report.js

[MITM]
hostname = %APPEND% one.google.com
