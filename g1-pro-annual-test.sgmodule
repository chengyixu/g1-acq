#!name=G1 Pro Annual Test
#!desc=v7.9.0 SKU管理兼容入口：引用g1-acq-v7.9-mappings；本机报告页支持添加、编辑、启停、保存、删除映射与恢复默认，最多30条，保存后下一次 /ai? 响应生效；默认discount75保留20TB 12个月试用目标g1.play.20tb.12months_eft、30TB三个月75p与2TB目标g1.2tb.ai.12months_ip_90p（无 .acq），自定义为custom，fallback=false；保留 /ai? 匹配范围与最近10次响应诊断；主入口为G1 ACQ SKU 管理，只开启一个改写入口
#!system=ios

[Rule]
# 与旧模块相同：拦截 UDP 443，作用于使用该配置的流量。
AND,((PROTOCOL,UDP),(DEST-PORT,443)),REJECT-NO-DROP

[Script]
g1-pro-annual-test = type=http-response,pattern=^https:\/\/one\.google\.com\/ai\?,requires-body=1,max-size=0,script-path=https://cdn.jsdelivr.net/gh/chengyixu/g1-acq@main/g1-acq.js
g1-sku-report = type=http-request,pattern=^https:\/\/one\.google\.com\/g1-sku-report\/?(?:\?.*)?$,requires-body=1,max-size=0,script-path=https://cdn.jsdelivr.net/gh/chengyixu/g1-acq@main/g1-sku-report.js

[MITM]
hostname = %APPEND% one.google.com
